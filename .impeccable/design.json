  "narrative": {
    "northStar": "Tesla's image-led research chapters",
    "overview": "The user-pinned Tesla reference establishes centered, spacious composition, full-bleed imagery, neutral typography, and simple rectangular actions. AegisLand retains its identity, research language, working evidence controls, and explicitly attributed NASA context media.\n\nThis is a record of the shipped homepage, not a replacement system for the working prototype or archived research surfaces. Ground truth is `deploy/vercel/index.html` and its stylesheet cascade: the homepage-specific `tesla-home.css` wins through scope and specificity while the final linked `tesla-editorial.css` continues to style the prototype separately. The opening direction contract records the pinned reference override (seed `8f1be4a2`).",
    "keyCharacteristics": [
      "Full-width media chapters with centered foreground copy.",
      "White navigation and open research sections with a pale comparison surface.",
      "Small-radius controls, flat containers, and clear evidence annotations.",
      "Visible source attribution, caveats, focus states, and individual film controls."
    ],
    "rules": [
      {
        "name": "The Evidence Color Rule",
        "body": "Camera annotation, matched-box, and unmatched-box colors keep their existing semantic meaning and legend labels; action blue does not replace them.",
        "section": "colors"
      },
      {
        "name": "The Paired Evidence Rule",
        "body": "Baseline and Phase 23 remain adjacent and comparable; narrow screens retain the pair and compact its labels and metrics.",
        "section": "layout"
      },
      {
        "name": "The Media Legibility Rule",
        "body": "Context media retains its dark foreground treatment, visible attribution, and evidence-boundary caption when used behind text.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the scoped homepage cascade as the source of truth for this surface.",
      "Do retain source attribution and evidence caveats beside context media and measurements.",
      "Do preserve paired camera evidence, semantic overlay colors, focus outlines, and film controls.",
      "Do use open sections and small-radius actions with generous chapter spacing."
    ],
    "donts": [
      "Don't propagate homepage overrides into the working prototype or archived research UI.",
      "Don't crop recorded camera evidence to imitate the full-bleed context-media treatment.",
      "Don't infer design tokens from overridden legacy declarations or screenshot capture artifacts."
    ]
  }
