+  if (auto error =
+          ValidateExecutionScope(_, inst, inst->GetOperandAs<uint32_t>(2))) {
+    return error;
+  }
+
   if (_.FindDef(inst->type_id())->opcode() != spv::Op::OpTypeEvent) {
     return _.diag(SPV_ERROR_INVALID_DATA, inst)
            << "The result type must be OpTypeEvent.";
@@
